# Copia este archivo como ".env" y rellena las claves que vayas obteniendo.
# Las fuentes sin clave (INE, OSM/Nominatim, Overpass, datos.gob.es) funcionan sin registrarte.

# AEMET OpenData API (gratuita, requiere registrarse en https://opendata.aemet.es/centrodedescargas/inicio)
AEMET_API_KEY=tu_clave_aemet_aqui

# AI (en este caso Gemini - https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_gemini_aqui

