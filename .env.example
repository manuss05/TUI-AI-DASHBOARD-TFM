# Copia este archivo como ".env" y rellena las claves que vayas obteniendo.
# Las fuentes sin clave (INE, OSM/Nominatim, Overpass, datos.gob.es) funcionan sin registrarte.

# TripAdvisor Content API -> https://tripadvisor-content-api.readme.io/reference/overview
TRIPADVISOR_API_KEY=

# Reddit API (gratuita, requiere registrar una "app" en https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tfm-turismo-espana/0.1 by tu_usuario

# Google Places API (de pago tras cuota gratuita) -> https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# Booking.com NO tiene API pública de autoservicio: ver src/extractors/booking_extractor.py
